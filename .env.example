# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，不会上传）

# 主模型（OpenAI 兼容接口；本地用火山方舟 ARK）
MODEL_NAME=ark-code-latest
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3

# 路由 / 结构化输出专用轻量模型（走 DashScope 兼容模式）
ROUTE_MODEL_NAME=doubao-seed-2.1-lite
DASHSCOPE_MODEL_NAME=qwen3.7-text-embedding
DASHSCOPE_API_KEY=your_dashscope_key_here

# 发件邮箱（SMTP）
EMAIL_FROM=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code
EMAIL_HOST=smtp.qq.com

# MySQL 业务库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hotel

# Redis（LangGraph Checkpointer 持久化）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
